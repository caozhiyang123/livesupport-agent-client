# Copy this file to .env and fill in real values. Do not commit .env.

# ARN of the AWS Bedrock AgentCore Harness to invoke (required).
# NOTE: despite the variable name, this is a Harness ARN (resource type
# "harness/...", invoked via invoke_harness), not an AgentCore Runtime
# "runtime/..." ARN (invoked via invoke_agent_runtime). The variable name
# is kept as AGENT_RUNTIME_ARN for backward compatibility with existing
# .env files.
#
# IMPORTANT: use the BARE harness ARN (no "/harness-endpoint/..." suffix).
# agent_client.py passes qualifier="DEFAULT" separately on each
# invoke_harness call, and AWS appends "/harness-endpoint/<qualifier>" to
# the ARN internally for authorization. If you put the endpoint suffix
# here too, the resulting resource path gets duplicated
# (".../harness-endpoint/DEFAULT/harness-endpoint/DEFAULT") and every call
# fails with AccessDeniedException even if the IAM policy is correct.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:harness/livesupport-agent-XXXXXXXXXX

# AWS region where the AgentCore Harness is deployed (required).
AWS_REGION=us-east-1

# Maximum number of /api/chat requests a single client may make within
# RATE_LIMIT_WINDOW_SECONDS before being rate limited.
RATE_LIMIT_MAX_REQUESTS=10

# Length in seconds of the rate limiting time window.
RATE_LIMIT_WINDOW_SECONDS=60

# Whether the chat UI/backend accepts pasted/uploaded images alongside
# text messages. Set to 1 to enable; defaults to 0 (disabled) so image
# input stays off unless explicitly turned on, e.g. to confirm the
# configured model (see AGENT_RUNTIME_ARN) supports image input.
SUPPORT_IMAGE=0

# Maximum number of images allowed in a single /api/chat request when
# SUPPORT_IMAGE=1.
MAX_IMAGES_PER_MESSAGE=3
